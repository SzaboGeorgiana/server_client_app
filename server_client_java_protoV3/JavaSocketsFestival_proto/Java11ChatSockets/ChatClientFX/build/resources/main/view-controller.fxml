<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="festival.client.gui.LoginController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Label layoutX="73.0" layoutY="60.0" text="LOGIN:">
            <font>
                <Font name="Bauhaus 93" size="23.0" />
            </font>
        </Label>
        <Label layoutX="94.0" layoutY="192.0" text="USERNAME: ">
            <font>
                <Font name="Bauhaus 93" size="21.0" />
            </font>
        </Label>
        <Label layoutX="94.0" layoutY="261.0" text="PASSWORD:">
            <font>
                <Font name="Bauhaus 93" size="21.0" />
            </font>
        </Label>
        <TextField fx:id="username" layoutX="226.0" layoutY="192.0" />
        <TextField fx:id="Parola" layoutX="226.0" layoutY="261.0" />
        <Button layoutX="272.0" layoutY="336.0" mnemonicParsing="false" onAction="#handleValid" prefHeight="25.0" prefWidth="56.0" text="OK">
            <font>
                <Font name="Bauhaus 93" size="12.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
